<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest entries. Merged only for debug builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".ui.PreviewExportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <receiver
            android:name=".notification.SyntheticNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.mini.hub.POST_SYNTHETIC_NOTIFICATION" />
                <action android:name="app.mini.hub.CANCEL_SYNTHETIC_NOTIFICATION" />
                <action android:name="app.mini.hub.REPOST_SYNTHETIC_NOTIFICATION" />
                <action android:name="app.mini.hub.DUMP_SYNTHETIC_STATE" />
                <action android:name="app.mini.hub.QUERY_DELIVERY_ACCOUNTING" />
                <action android:name="app.mini.hub.SET_ATTENTION" />
                <action android:name="app.mini.hub.DUMP_ATTENTION" />
                <action android:name="app.mini.hub.TRIGGER_UNBIND" />
                <action android:name="app.mini.hub.TRIGGER_REBIND" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".intelligence.LocalDraftEvaluationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.mini.hub.RUN_LOCAL_DRAFT_EVALUATION" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".intelligence.LocalAiDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.mini.hub.debug.LOCAL_AI_FAULT" />
                <action android:name="app.mini.hub.debug.LOCAL_AI_SIMULATE_PRESSURE" />
                <action android:name="app.mini.hub.debug.LOCAL_AI_STATUS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".connector.GateEvidenceDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.mini.hub.debug.RECORD_GATE" />
                <action android:name="app.mini.hub.debug.CLEAR_GATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
