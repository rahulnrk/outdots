<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required by JobInfo.setPersisted(true) so background sync survives reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Private stores are excluded from backup (architecture section 11). -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="Mini Hub"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:path="/oauth2redirect/google"
                    android:scheme="${gmailRedirectScheme}" />
                <data
                    android:path="/oauth2redirect/chat"
                    android:scheme="${gmailRedirectScheme}" />
            </intent-filter>
            <!-- app.mini.hub://oauth2redirect/<route>: host is "oauth2redirect", path is the route. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.mini.hub" android:host="oauth2redirect" android:path="/outlook" />
                <data android:scheme="app.mini.hub" android:host="oauth2redirect" android:path="/teams" />
                <data android:scheme="app.mini.hub" android:host="oauth2redirect" android:path="/slack" />
                <data android:scheme="app.mini.hub" android:host="oauth2redirect" android:path="/x" />
            </intent-filter>
        </activity>

        <service
            android:name=".connector.GmailSyncJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!--
          Owner-operated Instagram sign-in runs in a dedicated process so its
          process-global WebView data-directory suffix cannot collide with any
          other WebView. It is not exported and is launched only by the rtprobe
          debug entry. It stores the verified session and proves a harmless
          authenticated read; it never enables the account in normal Accounts.
        -->
        <activity
            android:name=".connector.InstagramLoginActivity"
            android:exported="false"
            android:process=":iglogin"
            android:label="Instagram sign-in" />

        <service
            android:name=".notification.MiniNotificationListenerService"
            android:label="Mini Hub Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".WhatsAppSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/media_paths" />
        </provider>
    </application>
</manifest>
